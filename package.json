{
  "name": "brainecho-site",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "cp data/notices.json out/notices.json",
    "start": "next start",
    "lint": "eslint",
    "deploy": "npx wrangler pages deploy out --project-name brainecho-website",
    "deploy:full": "python3 scripts/sync_notices.py && next build && npx wrangler pages deploy out --project-name brainecho-website",
    "sync:notices": "python3 scripts/sync_notices.py",
    "sync:deploy": "python3 scripts/sync_notices.py --deploy"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
